# API (read with the KINETIX_ prefix)
KINETIX_ENV=development
KINETIX_SECRET_KEY=change-me-to-64-random-characters   # required outside development; encrypts MFA secrets
KINETIX_APP_URL=http://localhost:3000                # used in invitation links
# The app connects as a restricted role; migrations connect as the schema owner.
# Superusers and BYPASSRLS roles skip row-level security, so the API refuses them in production.
KINETIX_DATABASE_URL=postgresql+psycopg://kinetix_app:kinetix_app@localhost:5432/kinetix
KINETIX_MIGRATION_DATABASE_URL=postgresql+psycopg://kinetix:kinetix@localhost:5432/kinetix
KINETIX_REDIS_URL=redis://localhost:6379/0
KINETIX_STORAGE_DIR=./var/storage
KINETIX_SCAN_MODE=inline        # inline (dev) or celery
KINETIX_COOKIE_SECURE=false     # true in any deployment served over HTTPS

# Web
KINETIX_API_URL=http://localhost:8000
KINETIX_DEMO=1                  # prefill the demo account on the sign-in page

# AI assistance runs on THIS SERVER's own provider key ("managed" mode, on by default). Users
# never paste a key. Every AI action is metered per user against their plan's quota, and the
# monthly token budget below is a server-wide backstop. The key is read server-side only: it is
# never sent to the browser, logged, or committed.
#
# Claude API (default provider) — create a key at console.anthropic.com:
ANTHROPIC_API_KEY=                      # or KINETIX_AI_API_KEY=sk-ant-...
# KINETIX_AI_MODEL=claude-sonnet-5-5    # or ANTHROPIC_MODEL; omit for the default
# KINETIX_AI_EFFORT=medium              # low | medium | high (cost per search); empty = don't send
# There is no silent fallback: without a key, AI features report "not configured".
#
# Alternatives: KINETIX_AI_PROVIDER=gemini (KINETIX_AI_API_KEY=AIza..., KINETIX_AI_GEMINI_TIER=free)
#   | openai_compatible (KINETIX_AI_BASE_URL=http://localhost:11434/v1, KINETIX_AI_MODEL=...)
#   | mock (development stub) | none (AI off).
KINETIX_AI_PROVIDER=anthropic
KINETIX_AI_MANAGED_ENABLED=true         # master switch for serving AI from the server key
# Reliability and spend controls:
KINETIX_AI_MAX_OUTPUT_TOKENS=4096       # cap tokens generated per request (reasoning included)
KINETIX_AI_MAX_RETRIES=4                # retries with backoff on 429/500/503/529
KINETIX_AI_TIMEOUT_SECONDS=60
# KINETIX_AI_MONTHLY_TOKEN_BUDGET=20000000  # optional hard cap on total tokens per UTC month
# KINETIX_AI_ALLOWED_ORGS=["your-workspace"]  # optional: restrict AI to these workspaces

# Per-user AI quotas. One "search" = one model call (Analyze, Ask, Draft, or one finding in a
# triage pass). The free allowance is one-time; paid plans reset monthly. Prices live in
# api/app/billing/plans.py. Billing stays off until Stripe is wired in (see docs/BILLING.md).
KINETIX_AI_FREE_SEARCHES=10
KINETIX_AI_PRO_MONTHLY_SEARCHES=300
KINETIX_AI_TEAM_MONTHLY_SEARCHES=2000
KINETIX_BILLING_ENABLED=false
# Owner accounts: this server is yours, so these accounts — and every member of a workspace they
# created — get unlimited Agentic Triage (no quota, no hourly limit). Comma-separated emails.
# Register each account before listing it (sign-up doesn't verify email).
# The monthly token budget above still applies as the server-wide backstop.
# KINETIX_OWNER_EMAILS=you@example.com

# Email: "console" prints messages to the API log; "resend" sends them (free tier 3,000/month).
KINETIX_EMAIL_BACKEND=console
# KINETIX_RESEND_API_KEY=re_...
# KINETIX_EMAIL_FROM="Kinetix <security@yourdomain.com>"
# Public demo only: the shared account can't change its password or turn on 2FA.
# KINETIX_DEMO_ACCOUNT_EMAIL=demo@kinetix.dev
