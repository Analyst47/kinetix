# API (read with the KINETIX_ prefix)
KINETIX_ENV=development
KINETIX_SECRET_KEY=change-me-to-64-random-characters   # required outside development; encrypts MFA secrets
KINETIX_APP_URL=http://localhost:3000                # used in invitation links
KINETIX_DATABASE_URL=postgresql+psycopg://kinetix:kinetix@localhost:5432/kinetix
KINETIX_REDIS_URL=redis://localhost:6379/0
KINETIX_STORAGE_DIR=./var/storage
KINETIX_SCAN_MODE=inline        # inline (dev) or celery
KINETIX_COOKIE_SECURE=false     # true in any deployment served over HTTPS

# Web
KINETIX_API_URL=http://localhost:8000
KINETIX_DEMO=1                  # prefill the demo account on the sign-in page
