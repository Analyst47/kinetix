# API (read with the KINETIX_ prefix)
KINETIX_ENV=development
KINETIX_SECRET_KEY=change-me-to-64-random-characters   # required outside development; encrypts MFA secrets
KINETIX_APP_URL=http://localhost:3000                # used in invitation links
# The app connects as a restricted role; migrations connect as the schema owner.
# Superusers and BYPASSRLS roles skip row-level security, so the API refuses them in production.
KINETIX_DATABASE_URL=postgresql+psycopg://kinetix_app:kinetix_app@localhost:5432/kinetix
KINETIX_MIGRATION_DATABASE_URL=postgresql+psycopg://kinetix:kinetix@localhost:5432/kinetix
KINETIX_REDIS_URL=redis://localhost:6379/0
KINETIX_STORAGE_DIR=./var/storage
KINETIX_SCAN_MODE=inline        # inline (dev) or celery
KINETIX_COOKIE_SECURE=false     # true in any deployment served over HTTPS

# Web
KINETIX_API_URL=http://localhost:8000
KINETIX_DEMO=1                  # prefill the demo account on the sign-in page

# AI assistance (optional). Off unless set; each workspace must also turn it on.
# The key is read server-side only and is never exposed to the browser, logs, or source control.
#
# Claude API (paid, recommended):
#   KINETIX_AI_PROVIDER=anthropic
#   KINETIX_AI_API_KEY=sk-ant-...        # or set ANTHROPIC_API_KEY instead (picked up automatically)
#   KINETIX_AI_MODEL=claude-sonnet-5-5   # or set ANTHROPIC_MODEL; omit for the default
#   Requests bill to your own Anthropic Console account at usage-based rates. There is no silent
#   fallback: if the key is missing, AI features report "not configured" rather than switching.
# Gemini API (free tier):
#   KINETIX_AI_PROVIDER=gemini  KINETIX_AI_API_KEY=AIza...  (model defaults to gemini-3.5-flash)
#   KINETIX_AI_GEMINI_TIER=free          # free tier: Google may use prompts to improve products
# Local Ollama (free):
#   KINETIX_AI_PROVIDER=openai_compatible  KINETIX_AI_BASE_URL=http://localhost:11434/v1  KINETIX_AI_MODEL=qwen2.5-coder:7b
# Development stub:  KINETIX_AI_PROVIDER=mock
KINETIX_AI_PROVIDER=none
# Reliability and spend controls (apply to every provider):
KINETIX_AI_MAX_OUTPUT_TOKENS=2048       # cap tokens generated per request
KINETIX_AI_MAX_RETRIES=4                # retries with backoff on 429/500/503/529
KINETIX_AI_TIMEOUT_SECONDS=60
# KINETIX_AI_MONTHLY_TOKEN_BUDGET=2000000  # optional hard cap on total tokens per UTC month

# Email: "console" prints messages to the API log; "resend" sends them (free tier 3,000/month).
KINETIX_EMAIL_BACKEND=console
# KINETIX_RESEND_API_KEY=re_...
# KINETIX_EMAIL_FROM="Kinetix <security@yourdomain.com>"
# Public demo only: the shared account can't change its password or turn on 2FA.
# KINETIX_DEMO_ACCOUNT_EMAIL=demo@kinetix.dev
