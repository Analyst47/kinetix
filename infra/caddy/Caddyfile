# Kinetix edge: the only public entry point.
#
# - /api/* goes straight to the API; everything else goes to the web app.
# - Upstreams receive exactly one X-Forwarded-For value: the client address Caddy decided
#   on. The API trusts that header only from this edge (KINETIX_TRUSTED_PROXIES).
# - Caddy trusts no upstream proxy by default (trust/none.caddy), so anything a client puts
#   in X-Forwarded-For or CF-Connecting-IP is ignored. Behind Cloudflare Tunnel, set
#   KINETIX_EDGE_TRUST=cloudflared to trust only the tunnel container.
# - With KINETIX_SITE_ADDRESS set to your domain (e.g. kinetix.example.com), Caddy gets and
#   renews HTTPS certificates automatically. The default, :80, is plain HTTP.
{
	admin off
	servers {
		import trust/{$KINETIX_EDGE_TRUST:none}.caddy
	}
}

{$KINETIX_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		-Server
		-X-Powered-By
	}

	@api path /api/*
	handle @api {
		# Archive uploads are capped at 200 MB by the API; allow a little framing overhead.
		request_body {
			max_size 210MB
		}
		reverse_proxy {$KINETIX_API_UPSTREAM:api:8000} {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy {$KINETIX_WEB_UPSTREAM:web:3000} {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format json
	}
}
